{
  "name": "bind-keys",
  "version": "1.0.0",
  "description": "A lightweight keyboard binding library for web applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --clean",
    "dev": "tsup index.ts --format cjs,esm --watch --dts",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "keyboard",
    "shortcuts",
    "hotkeys",
    "bindings"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.6.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
